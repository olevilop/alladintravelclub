# Пример настроек backend. Реальный файл .env создаётся ТОЛЬКО на сервере
# (скриптом deploy/setup-backend.sh) и НЕ попадает в репозиторий.

# ── Подключение к управляемой PostgreSQL Timeweb ─────────────────────────────
# Пароль в URL кодируется: @ -> %40
DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ.twc1.net:5432/ИМЯ_БАЗЫ?sslmode=verify-full
# Путь к CA-сертификату Timeweb (скачивается с https://st.timeweb.com/cloud-static/ca.crt)
CA_CERT_PATH=/var/www/alladintravelclub/backend/certs/root.crt

# ── Сервер API ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3101

# ── Авторизация админки ──────────────────────────────────────────────────────
JWT_SECRET=длинная-случайная-строка
JWT_EXPIRES=7d
# Первый администратор (создаётся командой npm run seed, если ещё нет)
ADMIN_EMAIL=admin@alladin.club
ADMIN_PASSWORD=задай-надёжный-пароль
ADMIN_NAME=Администратор

# ── Загрузка фото программ ───────────────────────────────────────────────────
UPLOAD_DIR=/var/www/alladintravelclub/backend/uploads
MAX_UPLOAD_MB=25
